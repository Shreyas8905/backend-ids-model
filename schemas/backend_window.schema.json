{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Backend IDS observation window",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "feature_version",
    "window",
    "workload",
    "features",
    "feature_status",
    "coverage",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "feature_version": {
      "const": "backend-features-v1"
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "duration_seconds"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "duration_seconds": {
          "const": 10
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "profile"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string"
        },
        "profile": {
          "enum": [
            "backend_full_v1",
            "backend_partial_v1"
          ]
        }
      }
    },
    "features": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "inbound_bytes_rate",
          "outbound_bytes_rate",
          "inbound_packets_rate",
          "outbound_packets_rate",
          "active_connections",
          "new_connections_rate",
          "failed_connections_rate",
          "connection_failure_ratio",
          "unique_peer_estimate",
          "unique_destination_ports",
          "unique_destination_ips",
          "inbound_outbound_ratio",
          "tcp_reset_rate",
          "tcp_retransmission_rate",
          "mean_connection_duration",
          "p95_connection_duration",
          "request_rate",
          "error_rate",
          "http_4xx_rate",
          "http_5xx_rate",
          "p50_request_latency_ms",
          "p95_request_latency_ms",
          "p99_request_latency_ms",
          "active_requests",
          "request_body_bytes_rate",
          "response_body_bytes_rate",
          "unique_route_count",
          "authentication_failure_rate",
          "http_get_ratio",
          "http_post_ratio",
          "http_put_ratio",
          "http_delete_ratio",
          "http_other_method_ratio",
          "http_2xx_ratio",
          "http_3xx_ratio",
          "http_4xx_ratio",
          "http_5xx_ratio",
          "cpu_utilization",
          "memory_utilization",
          "process_creation_rate",
          "process_termination_rate",
          "unique_executable_count",
          "unexpected_executable_count",
          "privileged_process_count",
          "oom_event_count",
          "container_restart_count",
          "request_rate_change",
          "error_rate_change",
          "inbound_rate_change",
          "outbound_rate_change",
          "connection_rate_change",
          "request_rate_ewma",
          "connection_rate_ewma",
          "request_rate_zscore",
          "latency_zscore",
          "connection_burst_score",
          "error_burst_score"
        ]
      },
      "additionalProperties": {
        "type": [
          "number",
          "null"
        ]
      }
    },
    "feature_status": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "inbound_bytes_rate",
          "outbound_bytes_rate",
          "inbound_packets_rate",
          "outbound_packets_rate",
          "active_connections",
          "new_connections_rate",
          "failed_connections_rate",
          "connection_failure_ratio",
          "unique_peer_estimate",
          "unique_destination_ports",
          "unique_destination_ips",
          "inbound_outbound_ratio",
          "tcp_reset_rate",
          "tcp_retransmission_rate",
          "mean_connection_duration",
          "p95_connection_duration",
          "request_rate",
          "error_rate",
          "http_4xx_rate",
          "http_5xx_rate",
          "p50_request_latency_ms",
          "p95_request_latency_ms",
          "p99_request_latency_ms",
          "active_requests",
          "request_body_bytes_rate",
          "response_body_bytes_rate",
          "unique_route_count",
          "authentication_failure_rate",
          "http_get_ratio",
          "http_post_ratio",
          "http_put_ratio",
          "http_delete_ratio",
          "http_other_method_ratio",
          "http_2xx_ratio",
          "http_3xx_ratio",
          "http_4xx_ratio",
          "http_5xx_ratio",
          "cpu_utilization",
          "memory_utilization",
          "process_creation_rate",
          "process_termination_rate",
          "unique_executable_count",
          "unexpected_executable_count",
          "privileged_process_count",
          "oom_event_count",
          "container_restart_count",
          "request_rate_change",
          "error_rate_change",
          "inbound_rate_change",
          "outbound_rate_change",
          "connection_rate_change",
          "request_rate_ewma",
          "connection_rate_ewma",
          "request_rate_zscore",
          "latency_zscore",
          "connection_burst_score",
          "error_burst_score"
        ]
      },
      "additionalProperties": {
        "enum": [
          "available",
          "partial",
          "unavailable",
          "invalid"
        ]
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network",
        "application",
        "host"
      ],
      "properties": {
        "network": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "application": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "host": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "temporal": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "source",
        "run_id",
        "synthetic"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "synthetic": {
          "type": "boolean"
        },
        "label_method": {
          "type": "string"
        },
        "label_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": true
    },
    "label": {
      "type": "object",
      "properties": {
        "event_type": {
          "enum": [
            "benign",
            "cyberattack",
            "operational_fault",
            "unknown"
          ]
        },
        "attack_category": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    }
  }
}